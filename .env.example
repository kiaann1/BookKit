# =============================================================================
# BookKit — environment variables
# Copy to .env.local (local dev) or set in Vercel → Settings → Environment Variables
# =============================================================================

# --- Required (all environments) ---

# PostgreSQL connection string (Neon, Supabase, local Docker, etc.)
DATABASE_URL="postgresql://user:password@host:5432/bookkit?sslmode=require"

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Public app URL (password reset links, canonical URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage (production: Vercel Blob) ---

# On Vercel: create a Blob store and connect it to the project — these are injected automatically.
# Local dev with Blob: run `vercel env pull` after linking the project.
# BLOB_READ_WRITE_TOKEN=""
# BLOB_STORE_ID=""

# Force local ./storage instead of Blob (dev only — do NOT set on Vercel)
# STORAGE_DRIVER=local

# Set to "public" only if your Blob store allows public objects; private stores proxy covers/PDFs via API
# BLOB_STORE_ACCESS=private

# Disable multipart uploads if large PDF uploads hang on your network
# BLOB_DISABLE_MULTIPART=true

# --- Storage (alternative: S3 / Cloudflare R2) ---

# STORAGE_DRIVER=s3
# S3_BUCKET_NAME=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
# S3_ENDPOINT=""
# S3_PUBLIC_URL=""

# --- Development helpers ---

# Skip login and browse as a mock admin (local dev only)
DISABLE_AUTH=true

# Read catalog from local storage/files instead of Postgres (empty on Vercel — never set in production)
# SKIP_DATABASE=true

# Comma-separated emails auto-promoted to ADMIN on login (also used for initial bootstrap)
ADMIN_EMAILS=kian.winwood1@gmail.com

# --- Optional integrations ---

# Google Books API for cover/metadata lookup when no cover is uploaded
# GOOGLE_BOOKS_API_KEY=""

# Disable Open Library / Google cover fallback
# DISABLE_COVER_LOOKUP=true
