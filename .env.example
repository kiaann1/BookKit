# Skip login while building UI (development only)
DISABLE_AUTH=true

# Database (PostgreSQL — Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/bookkit?schema=public&connect_timeout=2"

# Skip DB when Postgres isn't running (dev only — uses local test book fallback)
# SKIP_DATABASE=true

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public app URL (used for password reset links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage — "local" saves files to ./storage (default for dev)
STORAGE_DRIVER=local

# Cover art — fetches from Open Library by title/author when no upload exists
# DISABLE_COVER_LOOKUP=true

# Auto-fill author, genres, and description from Open Library (+ Google Books when keyed)
# DISABLE_METADATA_LOOKUP=true
# GOOGLE_BOOKS_API_KEY=""
#
# Storage folder naming (improves cover/metadata matching):
#   books/{title-slug}--{author-slug}/original.pdf
# Examples: project-hail-mary--andy-weir  the-ascended--greenwich-lennox
# Also works: the-ascended-greenwich-lennox (4-part "the-..." folders)
# On Windows, if covers fail with TLS/certificate errors, npm scripts already pass
# node --use-system-ca. For custom starts: NODE_OPTIONS=--use-system-ca

# S3-compatible storage (Cloudflare R2, AWS S3) — set STORAGE_DRIVER=s3
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION=auto
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME=""
# S3_PUBLIC_URL="https://cdn.yourdomain.com"

# Optional: email for password reset (Phase 7)
# RESEND_API_KEY=""
