generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  READER
  ADMIN
}

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ShelfStatus {
  WANT_TO_READ
  CURRENTLY_READING
  READ
  DNF
}

enum FollowListVisibility {
  PUBLIC
  FOLLOWERS
  ONLY_SELF
}

enum PostType {
  TEXT
  IMAGE
  ARTICLE
  VIDEO
}

enum BookRequestStatus {
  PENDING
  SOURCED
  ADDED
  DECLINED
}

enum NotificationType {
  NEW_BOOK_IN_GENRE
  FOLLOW
  POST_LIKE
  POST_COMMENT
  BOOK_REQUEST_UPDATED
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime?
  username              String    @unique
  passwordHash          String?
  firstName             String?
  lastName              String?
  name                  String?
  phone                 String?
  bio                   String?
  avatarUrl             String?
  genrePreferences      String[]  @default([])
  booksPerWeek          Int?
  onboardingCompletedAt DateTime?
  isPrivate             Boolean              @default(false)
  followersListVisibility FollowListVisibility @default(PUBLIC)
  role                  UserRole             @default(READER)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([firstName, lastName])

  accounts       Account[]
  sessions       Session[]
  books          Book[]
  shelf          UserBook[]
  posts          Post[]
  postLikes      PostLike[]
  comments       Comment[]
  postReports    PostReport[] @relation("PostReports")
  userReports    UserReport[] @relation("UserReports")
  reportsFiled   UserReport[] @relation("ReportsFiled")
  followers      Follow[]     @relation("Following")
  following      Follow[]     @relation("Follower")
  blockedUsers   UserBlock[]  @relation("BlocksInitiated")
  blockedBy      UserBlock[]  @relation("BlocksReceived")
  bookRequests       BookRequest[]
  bookRequestVotes   BookRequestVote[]
  notifications      Notification[]
  conversationsLow   Conversation[] @relation("ConversationsLow")
  conversationsHigh  Conversation[] @relation("ConversationsHigh")
  messagesSent       Message[]
}

model Book {
  id           String     @id @default(cuid())
  title        String
  author       String
  description  String?    @db.Text
  coverKey     String?
  pdfKey       String
  genres       String[]
  publishedAt  DateTime?
  seriesTitle  String?
  seriesIndex  Int?
  status       BookStatus @default(PUBLISHED)
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  shelfEntries UserBook[]
  posts        Post[]
  linkedRequests BookRequest[]

  @@index([status])
  @@index([title])
  @@index([author])
}

model UserBook {
  id              String      @id @default(cuid())
  userId          String
  bookId          String
  status          ShelfStatus @default(WANT_TO_READ)
  rating          Int?
  review          String?     @db.Text
  startedAt       DateTime?
  finishedAt      DateTime?
  currentPage     Int?
  totalPages      Int?
  progressPercent Float?
  lastReadAt      DateTime?
  showcaseOrder   Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, showcaseOrder])
  @@index([bookId, updatedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  type      PostType @default(TEXT)
  title     String?
  body      String   @db.Text
  mediaKey  String?
  bookId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book?        @relation(fields: [bookId], references: [id], onDelete: SetNull)
  likes    PostLike[]
  comments Comment[]
  reports  PostReport[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([bookId, createdAt])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostReport {
  id         String   @id @default(cuid())
  postId     String
  reporterId String
  reason     String?  @db.Text
  createdAt  DateTime @default(now())

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation("PostReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([postId])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserReport {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         String?  @db.Text
  createdAt      DateTime @default(now())

  reporter     User @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("UserReports", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@unique([reporterId, reportedUserId])
  @@index([reportedUserId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model BookRequest {
  id           String            @id @default(cuid())
  userId       String
  title        String
  author       String
  notes        String?           @db.Text
  isbn         String?
  status       BookRequestStatus @default(PENDING)
  adminNote    String?           @db.Text
  linkedBookId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedBook Book?             @relation(fields: [linkedBookId], references: [id], onDelete: SetNull)
  votes      BookRequestVote[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model BookRequestVote {
  requestId String
  userId    String
  createdAt DateTime @default(now())

  request BookRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requestId, userId])
  @@index([requestId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Conversation {
  id                String   @id @default(cuid())
  participantLowId  String
  participantHighId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastMessageAt     DateTime @default(now())

  participantLow  User      @relation("ConversationsLow", fields: [participantLowId], references: [id], onDelete: Cascade)
  participantHigh User      @relation("ConversationsHigh", fields: [participantHighId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([participantLowId, participantHighId])
  @@index([participantLowId, lastMessageAt])
  @@index([participantHighId, lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String    @db.Text
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
