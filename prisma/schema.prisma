generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  READER
  ADMIN
}

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ShelfStatus {
  WANT_TO_READ
  CURRENTLY_READING
  READ
  DNF
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime?
  username              String    @unique
  passwordHash          String?
  firstName             String?
  lastName              String?
  name                  String?
  phone                 String?
  bio                   String?
  avatarUrl             String?
  genrePreferences      String[]  @default([])
  booksPerWeek          Int?
  onboardingCompletedAt DateTime?
  role                  UserRole  @default(READER)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([firstName, lastName])

  accounts  Account[]
  sessions  Session[]
  books     Book[]
  shelf     UserBook[]
}

model Book {
  id           String     @id @default(cuid())
  title        String
  author       String
  description  String?    @db.Text
  coverKey     String?
  pdfKey       String
  genres       String[]
  publishedAt  DateTime?
  seriesTitle  String?
  seriesIndex  Int?
  status       BookStatus @default(PUBLISHED)
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  shelfEntries UserBook[]

  @@index([status])
  @@index([title])
  @@index([author])
}

model UserBook {
  id              String      @id @default(cuid())
  userId          String
  bookId          String
  status          ShelfStatus @default(WANT_TO_READ)
  rating          Int?
  review          String?     @db.Text
  startedAt       DateTime?
  finishedAt      DateTime?
  currentPage     Int?
  totalPages      Int?
  progressPercent Float?
  lastReadAt      DateTime?
  showcaseOrder   Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, showcaseOrder])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
